/*
 * Corne dongle (nice!nano v2): BLE central for both Corne halves,
 * with a PAW3395 optical sensor and 5 direct-wired buttons.
 *
 * Wiring (pro_micro pin -> nRF pin):
 *   PAW3395 (high-frequency pins only)
 *     SCLK   D18 -> P1.15
 *     MOSI   D19 -> P0.02
 *     MISO   D20 -> P0.29
 *     NCS    D21 -> P0.31
 *     MOTION D15 -> P1.13
 *   Buttons (to GND, internal pull-up)
 *     BTN1 D4 -> P0.22
 *     BTN2 D5 -> P0.24
 *     BTN3 D6 -> P1.00
 *     BTN4 D8 -> P1.04 (low-frequency pin, fine for a button)
 *     BTN5 D9 -> P1.06 (low-frequency pin, fine for a button)
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    chosen {
        zmk,kscan = &kscan_composite;
        zmk,matrix-transform = &dongle_transform;
    };

    /*
     * Positions 0-41 match the stock Corne 6-column transform (the halves
     * compute positions themselves and send them to the dongle).
     * Positions 42-46 are the dongle's own buttons on row 4.
     */
    dongle_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                        RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8)
                RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4)
        >;
    };

    kscan_buttons: kscan_buttons {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };

    // Shift the dongle buttons to row 4 so they don't collide with the halves
    kscan_composite: kscan_composite {
        compatible = "zmk,kscan-composite";
        rows = <5>;
        columns = <12>;

        buttons {
            kscan = <&kscan_buttons>;
            row-offset = <4>;
        };
    };

    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&paw3395>;
    };
};

&pinctrl {
    spi2_default: spi2_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 2)>,
                    <NRF_PSEL(SPIM_MISO, 0, 29)>;
        };
    };

    spi2_sleep: spi2_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 2)>,
                    <NRF_PSEL(SPIM_MISO, 0, 29)>;
            low-power-enable;
        };
    };
};

&spi2 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi2_default>;
    pinctrl-1 = <&spi2_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 31 GPIO_ACTIVE_LOW>;

    paw3395: paw3395@0 {
        compatible = "pixart,paw3395";
        status = "okay";
        reg = <0>;
        spi-max-frequency = <4000000>;
        irq-gpios = <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <800>;
        // swap-xy;
        // invert-x;
        // invert-y;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
    };
};
