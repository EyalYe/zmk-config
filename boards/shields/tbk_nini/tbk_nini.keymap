/*
 * The halves are peripherals: they only report key positions to the dongle,
 * which runs the real keymap (config/corne_dongle.keymap). This keymap only
 * exists so the half builds have one.
 */

#include <behaviors.dtsi>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&none &none &none &none &none &none  &none &none &none &none &none &none
&none &none &none &none &none &none  &none &none &none &none &none &none
&none &none &none &none &none &none  &none &none &none &none &none &none
                  &none &none &none  &none &none &none &none
            >;
        };
    };
};
