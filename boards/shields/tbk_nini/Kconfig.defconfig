if SHIELD_TBK_NINI_DONGLE || SHIELD_TBK_NINI_LEFT || SHIELD_TBK_NINI_RIGHT

config ZMK_POINTING
    default y

config ZMK_SPLIT
    default y

config ZMK_SPLIT_BLE
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 3

config BT_MAX_CONN
    default 8

config BT_MAX_PAIRED
    default 8

# Display/LVGL defaults are intentionally NOT set here: the dongle's color
# ST7789V screen is fully configured by the prospector_adapter shield. Adding
# SSD1306 / 1-bpp / mono LVGL defaults would clobber it and break the screen.
# If a half ever gets an OLED, add those guarded by LEFT || RIGHT only.

endif

if SHIELD_TBK_NINI_DONGLE

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_TBK_NINI_LEFT || SHIELD_TBK_NINI_RIGHT

config SPI
    default y

endif
