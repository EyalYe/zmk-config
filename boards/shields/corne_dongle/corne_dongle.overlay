/*
 * Corne dongle (nice!nano v2): BLE central for both Corne halves,
 * with a PAW3395 optical sensor and 5 direct-wired buttons.
 *
 * Wiring (pro_micro pin -> nRF pin):
 *   PAW3395 (high-frequency pins)
 *     SCLK   D1  -> P0.06
 *     MOSI   D0  -> P0.08
 *     MISO   D2  -> P0.17
 *     NCS    D3  -> P0.20
 *     MOTION D4  -> P0.22
 *   Buttons (to GND, internal pull-up; low-frequency pins are fine here)
 *     BTN1 D8  -> P1.04
 *     BTN2 D9  -> P1.06
 *     BTN3 D10 -> P0.09 (NFC pin, enabled as GPIO below)
 *     BTN4 D16 -> P0.10 (NFC pin, enabled as GPIO below)
 *     BTN5 D14 -> P1.11
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    chosen {
        zmk,kscan = &kscan_composite;
        zmk,matrix-transform = &dongle_transform;
    };

    /*
     * Positions 0-41 match the stock Corne 6-column transform (the halves
     * compute positions themselves and send them to the dongle).
     * Positions 42-46 are the dongle's own buttons on row 4.
     */
    dongle_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                        RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8)
                RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4)
        >;
    };

    kscan_buttons: kscan_buttons {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&gpio1 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio1 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };

    // Shift the dongle buttons to row 4 so they don't collide with the halves
    kscan_composite: kscan_composite {
        compatible = "zmk,kscan-composite";
        rows = <5>;
        columns = <12>;

        buttons {
            kscan = <&kscan_buttons>;
            row-offset = <4>;
        };
    };

    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&paw3395>;
    };
};

// P0.09 / P0.10 default to NFC antenna pins; use them as plain GPIOs
&uicr {
    nfct-pins-as-gpios;
};

&pinctrl {
    spi2_default: spi2_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 6)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 8)>,
                    <NRF_PSEL(SPIM_MISO, 0, 17)>;
        };
    };

    spi2_sleep: spi2_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 6)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 8)>,
                    <NRF_PSEL(SPIM_MISO, 0, 17)>;
            low-power-enable;
        };
    };
};

&spi2 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi2_default>;
    pinctrl-1 = <&spi2_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;

    paw3395: paw3395@0 {
        compatible = "pixart,paw3395";
        status = "okay";
        reg = <0>;
        spi-max-frequency = <4000000>;
        irq-gpios = <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <800>;
        // swap-xy;
        // invert-x;
        // invert-y;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
    };
};
