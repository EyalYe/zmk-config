
#include "tbk_nini.dtsi"
#include <input/processors.dtsi>


/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackball_split: trackball@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "okay";
        device = <&trackball_split>;
        input-processors = <&zip_xy_scaler 0 1>;

        scroller {
          layers = <8>;
          input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_scaler 1 12>;
        };

        snipe {
          layers = <9>;
          input-processors = <&zip_xy_scaler 5 2>, <&zip_y_scaler 3 2>;
        };

        enable {
          layers = <1>;
          input-processors = <&zip_xy_scaler 1 3>;
        };
        };
};

&kscan0 {
    row-gpios
        = <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // D8  = P1.04
        , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // D5  = P0.24
        , <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // D6  = P1.00
        , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // D7  = P0.11
        ;
    col-gpios
        = <&gpio0 31 GPIO_ACTIVE_HIGH>   // D21 = P0.31
        , <&gpio0 29 GPIO_ACTIVE_HIGH>   // D20 = P0.29
        , <&gpio0 2  GPIO_ACTIVE_HIGH>   // D19 = P0.02
        , <&gpio1 15 GPIO_ACTIVE_HIGH>   // D18 = P1.15
        , <&gpio1 13 GPIO_ACTIVE_HIGH>   // D15 = P1.13
        , <&gpio1 11 GPIO_ACTIVE_HIGH>   // D14 = P1.11
        ;
};
